{
  "version": 1,
  "controller": "claude-code",
  "roles": {
    "build": ["antigravity-cli", "codex-cli", "opencode"],
    "fix": ["codex-cli", "antigravity-cli"],
    "test": ["opencode", "kilo-free", "openrouter-free"],
    "docs": ["kilo-free", "openrouter-free", "opencode-zen", "gemini-api"],
    "review": ["codex-cli", "antigravity-cli"],
    "ask": ["antigravity-cli", "gemini-api", "kilo-free"]
  },
  "providers": {
    "openrouter-free": { "model": "openrouter/free" },
    "ollama": { "enabled": true, "model": "qwen3-coder" },
    "kimi-api": { "enabled": true }
  },
  "settings": { "cooldownMinutes": 20, "verify": "npm run lint && npm test" }
}
